// Archivo: infra/ManejadorDeErrores.java
// Captura excepciones y devuelve respuestas HTTP legibles

package com.alura.foroHub.infra;

import org.springframework.http.ResponseEntity;
import org.springframework.validation.FieldError;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestControllerAdvice  // Intercepta errores de todos los controladores
public class ManejadorDeErrores {

    // Error 400 por campos inválidos (@NotBlank, etc.)
    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ResponseEntity<List<ErrorValidacion>> manejarError400(MethodArgumentNotValidException e) {
        var errores = e.getFieldErrors().stream().map(ErrorValidacion::new).toList();
        return ResponseEntity.badRequest().body(errores);
    }

    // Error 400 por reglas de negocio (ej: tópico duplicado)
    @ExceptionHandler(IllegalArgumentException.class)
    public ResponseEntity<String> manejarErrorNegocio(IllegalArgumentException e) {
        return ResponseEntity.badRequest().body(e.getMessage());
    }

    private record ErrorValidacion(String campo, String mensaje) {
        ErrorValidacion(FieldError e) { this(e.getField(), e.getDefaultMessage()); }
    }
}


