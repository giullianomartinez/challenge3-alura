package com.alura.foroHub.model;

import jakarta.persistence.*;
import lombok.*;
import java.time.LocalDateTime;

@Entity               // Le dice a JPA: "esta clase es una tabla en la BD"
@Table(name = "topicos")
@Getter @Setter
@NoArgsConstructor
public class Topico {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY) // ID autoincremental
    private Long id;

    private String titulo;
    private String mensaje;
    private LocalDateTime fechaCreacion;

    @Enumerated(EnumType.STRING)
    private StatusTopico status;

    private String autor;
    private String curso;

    @PrePersist // Se ejecuta automáticamente antes de guardar en BD
    public void prePersist() {
        this.fechaCreacion = LocalDateTime.now();
        this.status = StatusTopico.ABIERTO;
    }

    // Método para actualizar solo los campos que llegaron en la solicitud
    public void actualizar(String titulo, String mensaje, String autor, String curso, StatusTopico status) {
        if (titulo  != null) this.titulo  = titulo;
        if (mensaje != null) this.mensaje = mensaje;
        if (autor   != null) this.autor   = autor;
        if (curso   != null) this.curso   = curso;
        if (status  != null) this.status  = status;
    }
}


