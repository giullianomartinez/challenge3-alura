package com.alura.foroHub.dto;

import com.alura.foroHub.model.*;
import jakarta.validation.constraints.NotBlank;
import java.time.LocalDateTime;

public class TopicoDTO {

    // Lo que el cliente ENVÍA al crear un tópico
    public record RegistroTopicoRequest(
        @NotBlank String titulo,   // @NotBlank valida que no llegue vacío
        @NotBlank String mensaje,
        @NotBlank String autor,
        @NotBlank String curso
    ) {}

    // Lo que el cliente ENVÍA al actualizar (todos opcionales)
    public record ActualizarTopicoRequest(
        String titulo, String mensaje,
        String autor,  String curso,
        StatusTopico status
    ) {}

    // Lo que la API DEVUELVE con todos los datos del tópico
    public record TopicoResponse(
        Long id, String titulo, String mensaje,
        LocalDateTime fechaCreacion, StatusTopico status,
        String autor, String curso
    ) {
        public TopicoResponse(Topico t) {
            this(t.getId(), t.getTitulo(), t.getMensaje(),
                 t.getFechaCreacion(), t.getStatus(),
                 t.getAutor(), t.getCurso());
        }
    }
}


